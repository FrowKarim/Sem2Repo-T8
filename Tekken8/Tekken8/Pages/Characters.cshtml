@page
@model CharactersModel
@{
    ViewData["Title"] = "Characters";
}

<div class="container mt-5">
    <h1 class="mb-4">Tekken 8 Characters</h1>

    <div class="row">
        @if (Model.Characters != null && Model.Characters.Any())
        {
            @foreach (var character in Model.Characters)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <a asp-route-characterID="@character.Id" class="character-card-link" style="text-decoration: none;">
                        <div class="card character-card shadow-sm h-100 transition-all">
                            <div class="card-header bg-dark text-white">
                                <h5 class="mb-0">@character.Name</h5>
                            </div>
                            <div class="card-body d-flex flex-column">
                            </div>
                            <div class="card-footer bg-light">
                                <span class="text-primary" >View Details →</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Characters Found</h4>
                    <p>There are no characters available at the moment.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .character-card {
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

    .character-card-link {
        color: inherit;
    }

    .character-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
    }

    .character-card .card-header {
        border-bottom: 2px solid #444;
    }

    .character-card .card-body {
        padding: 1.25rem;
    }

    .character-card .card-footer {
        border-top: 1px solid #dee2e6;
        padding: 0.75rem 1.25rem;
        background-color: #f8f9fa !important;
        color: #0d6efd;
        font-weight: 500;
    }

    .character-card:hover .card-footer {
        background-color: #e8f0ff !important;
    }

    h1 {
        color: #333;
        font-weight: 700;
        border-bottom: 3px solid #0d6efd;
        padding-bottom: 0.5rem;
    }
</style>
