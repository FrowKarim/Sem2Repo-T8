@page
@model CharactersModel
@{
    ViewData["Title"] = "Characters";
}

<div class="container mt-5">
    <h1 class="mb-4">Tekken 8 Characters</h1>

    <div class="row">
        @if (Model.Characters != null && Model.Characters.Any())
        {
            @foreach (var character in Model.Characters)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <a asp-page="Details" asp-route-characterID="@character.Id" class="character-card-link" style="text-decoration: none;">
                        <div class="card character-card shadow-sm h-100 transition-all">
                            <div class="card-header bg-dark text-white">
                                <h5 class="mb-0">@character.Name</h5>
                            </div>
                            <div class="card-body d-flex flex-column">
                            </div>
                            <div class="card-footer bg-light">
                                <span class="text-primary" >View Details →</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Characters Found</h4>
                    <p>There are no characters available at the moment.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .character-card {
        border: 1px solid #667eea;
        background: rgba(45, 34, 87, 0.5);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

    .character-card-link {
        color: inherit;
    }

    .character-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4) !important;
    }

    .character-card .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border-bottom: 2px solid #764ba2;
        color: #fff !important;
    }

    .character-card .card-header h5 {
        color: #fff;
    }

    .character-card .card-body {
        padding: 1.25rem;
        background-color: rgba(60, 50, 80, 0.6);
    }

    .character-card .card-footer {
        border-top: 1px solid rgba(102, 126, 234, 0.3);
        padding: 0.75rem 1.25rem;
        background-color: rgba(50, 45, 70, 0.8) !important;
        color: #667eea;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .character-card:hover .card-footer {
        background-color: rgba(102, 126, 234, 0.15) !important;
        color: #764ba2;
    }

    .container > h1 {
        color: #f0f0f0;
        font-weight: 700;
        border-bottom: 3px solid #667eea;
        padding-bottom: 0.5rem;
    }

    .alert-info {
        background-color: rgba(102, 126, 234, 0.15) !important;
        border: 1px solid #667eea !important;
        color: #e0e0e0 !important;
    }

    .alert-info h4 {
        color: #667eea !important;
    }

    .alert-info p {
        color: #b0b0b0 !important;
        margin: 0;
    }
</style>
