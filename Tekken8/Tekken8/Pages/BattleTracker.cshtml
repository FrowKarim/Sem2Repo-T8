@page
@model Tekken8.Pages.BattleTrackerModel

<div class="search-container">
    <h1>Input your TekkenID here</h1>
    <form method="post">
        <div style="flex: 1;">
            <label asp-for="TekkenID">TekkenID</label>
            <input asp-for="TekkenID" type="text" placeholder="2YEH85DaLhE6" />
        </div>
        <input type="submit" value="Search Recent battles" />
    </form>
</div>

@if (Model.Battles != null && Model.Battles.Any())
{
    <div class="win-rate-container">
         Win Rate: <span style="color: #007bff;">@Model.WinRate.ToString("F2")%</span>
    </div>

    <div class="battles-grid">
        @foreach (var battle in Model.Battles)
        {
            var isWin = (battle.Winner == 1 && battle.P1TekkenId == Model.TekkenID) || 
                        (battle.Winner == 2 && battle.P2TekkenId == Model.TekkenID);
            var resultText = isWin ? "WIN" : "LOSS";
            var resultColor = isWin ? "#28a745" : "#dc3545";

            <div class="battle-card">
                <div class="battle-header">
                    <div>
                        <h3>@battle.BattleType</h3>
                        <span class="battle-date">@battle.BattleAt.ToString("g")</span>
                    </div>
                </div>
                <div class="battle-body">
                    <div class="result-container" style="background-color: @(isWin ? "#d4edda" : "#f8d7da"); border-color: @resultColor;">
                        <div class="result-label">Result</div>
                        <div class="result-value" style="color: @resultColor;">@resultText</div>
                    </div>

                    <div class="players-container">
                        <div class="player-info" style="border-left-color: @(battle.P1TekkenId == Model.TekkenID ? "#ffc107" : "#667eea");">
                            <h4>@battle.P1Name</h4>
                            <div class="player-detail">
                                <span class="player-detail-label">Character:</span>
                                <span class="player-detail-value">@battle.P1Char</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Rank:</span>
                                <span class="player-detail-value">@battle.P1DanRank</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Power:</span>
                                <span class="player-detail-value">@battle.P1TekkenPower</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Rounds Won:</span>
                                <span class="player-detail-value">@battle.P1RoundsWon</span>
                            </div>
                        </div>

                        <div class="player-info" style="border-left-color: @(battle.P2TekkenId == Model.TekkenID ? "#ffc107" : "#667eea");">
                            <h4>@battle.P2Name</h4>
                            <div class="player-detail">
                                <span class="player-detail-label">Character:</span>
                                <span class="player-detail-value">@battle.P2Char</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Rank:</span>
                                <span class="player-detail-value">@battle.P2DanRank</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Power:</span>
                                <span class="player-detail-value">@battle.P2TekkenPower</span>
                            </div>
                            <div class="player-detail">
                                <span class="player-detail-label">Rounds Won:</span>
                                <span class="player-detail-value">@battle.P2RoundsWon</span>
                            </div>
                        </div>
                    </div>

                    <div class="battle-meta">
                        <span>Stage ID: @battle.StageId</span>
                        <span>Version: @battle.GameVersion</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="no-battles">
        <p>No battles found for the provided TekkenID.</p>
    </div>
}


<style>
    .search-container {
        margin-bottom: 30px;
        padding: 20px;
        background-color: rgba(50, 45, 70, 0.8);
        border-radius: 8px;
        border: 1px solid #667eea;
    }

        .search-container h1 {
            margin-top: 0;
            color: #f0f0f0;
        }

        .search-container form {
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .search-container label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #e0e0e0;
        }

        .search-container input[type="text"] {
            padding: 8px 12px;
            border: 1px solid #667eea;
            border-radius: 4px;
            font-size: 14px;
            background-color: #2a2535;
            color: #e0e0e0;
        }

        .search-container input[type="text"]::placeholder {
            color: #999;
        }

        .search-container input[type="submit"] {
            padding: 8px 16px;
            background-color: #667eea;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.2s;
        }

            .search-container input[type="submit"]:hover {
                background-color: #764ba2;
            }

    .win-rate-container {
        margin-bottom: 20px;
        padding: 15px;
        background-color: rgba(102, 126, 234, 0.15);
        border-left: 4px solid #667eea;
        border-radius: 4px;
        font-size: 16px;
        font-weight: bold;
        color: #e0e0e0;
    }

    .battles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .battle-card {
        background: rgba(45, 34, 87, 0.5);
        border: 1px solid #667eea;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.2);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .battle-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

    .battle-header {
        background: linear-gradient(135deg, #2e225a 0%, #292636 55%, #232226 100%);
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .battle-header h3 {
            margin: 0;
            font-size: 16px;
            color: #fff;
        }

    .battle-date {
        font-size: 12px;
        opacity: 0.9;
        color: #fff;
    }

    .battle-body {
        padding: 20px;
    }

    .players-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 15px;
    }

    .player-info {
        background-color: rgba(60, 50, 80, 0.8);
        padding: 12px;
        border-radius: 6px;
        border-left: 3px solid #667eea;
    }

        .player-info h4 {
            margin: 0 0 8px 0;
            font-size: 14px;
            color: #f0f0f0;
        }

    .player-detail {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-size: 13px;
    }

    .player-detail-label {
        font-weight: bold;
        color: #b0b0b0;
    }

    .player-detail-value {
        color: #e0e0e0;
    }

    .result-container {
        background-color: rgba(255, 193, 7, 0.15);
        border: 1px solid #ffc107;
        border-radius: 6px;
        padding: 12px;
        margin-bottom: 12px;
        text-align: center;
    }

    .result-label {
        font-size: 12px;
        color: #ffc107;
        font-weight: bold;
    }

    .result-value {
        font-size: 16px;
        color: #ffc107;
        font-weight: bold;
        margin-top: 4px;
    }

    .battle-meta {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #999;
        padding-top: 12px;
        border-top: 1px solid rgba(102, 126, 234, 0.2);
    }

    .no-battles {
        text-align: center;
        padding: 40px 20px;
        background-color: rgba(50, 45, 70, 0.8);
        border-radius: 8px;
        color: #b0b0b0;
        border: 1px solid #667eea;
    }
</style>