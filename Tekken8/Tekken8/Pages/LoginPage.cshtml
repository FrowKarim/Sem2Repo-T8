@page
@model Tekken8.Pages.LoginPageModel

<div class="auth-container">
    <h1>Login</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-error">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Username"></label>
            <input asp-for="Input.Username" class="form-control" />
            <span asp-validation-for="Input.Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="auth-button-group">
            <button type="submit" class="btn-auth-primary">Login</button>
            <a asp-page="/Register" class="btn-auth-secondary">Create an account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .auth-container {
        max-width: 420px;
        margin: 50px auto;
        padding: 25px;
        background-color: rgba(50, 45, 70, 0.9);
        border-radius: 8px;
        border: 1px solid #667eea;
        color: #f0f0f0;
    }

        .auth-container h1 {
            margin-bottom: 20px;
        }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #667eea;
        background-color: #2a2535;
        color: #fff;
    }

    .auth-button-group {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-auth-primary,
    .btn-auth-secondary {
        flex: 1;
        padding: 10px 18px;
        text-align: center;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-auth-primary {
        background-color: #667eea;
        color: white;
        border: none;
    }

        .btn-auth-primary:hover {
            background-color: #764ba2;
        }

    .btn-auth-secondary {
        background-color: transparent;
        border: 1px solid #667eea;
        color: white;
    }

        .btn-auth-secondary:hover {
            background-color: #667eea;
            color: white;
        }

    .auth-error {
        margin-bottom: 15px;
        padding: 10px;
        background-color: #f8d7da;
        color: #842029;
        border-radius: 4px;
    }

    .text-danger {
        color: #ff8080;
        font-size: 13px;
    }
</style>