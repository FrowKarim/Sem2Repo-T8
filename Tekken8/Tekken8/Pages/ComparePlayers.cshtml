@page
@model Tekken8.Pages.ComparePlayersModel

<div class="compare-page">
    <div class="compare-header">
        <h1>Compare Players</h1>
        <p>Side-by-side battle statistics comparison</p>
    </div>

    @if (!ViewContext.ModelState.IsValid)
    {
        <div class="error-box">
            @foreach (var error in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @if (Model.ComparisonResult != null)
    {
        <div class="compare-grid">
            <div class="player-column">
                <div class="player-card">
                    <h2>@Model.ComparisonResult.Player1.PlayerName</h2>
                    <div class="player-id">@Model.ComparisonResult.Player1.TekkenId</div>

                    <div class="stat-box">
                        <div class="stat-label">Overall Win Rate</div>
                        <div class="stat-value">@Model.ComparisonResult.Player1.OverallWinRate.ToString("F2")%</div>
                    </div>

                    <div class="summary-list">
                        <div class="summary-item">
                            <span class="summary-label">Region</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.Region</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Total Battles</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.TotalBattles</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Average Tekken Power</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.AverageTekkenPower.ToString("F0")</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Average Rounds Won</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.AverageRoundsWon.ToString("F2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Most Played Character</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player1.MostPlayedCharacter
                                (@Model.ComparisonResult.Player1.MostPlayedCharacterGames)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Best Character</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player1.BestCharacter
                                (@Model.ComparisonResult.Player1.BestCharacterWinRate.ToString("F2")%)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Worst Matchup</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player1.WorstMatchupCharacter
                                (@Model.ComparisonResult.Player1.WorstMatchupWinRate.ToString("F2")%)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Favorite Battle Type</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.FavoriteBattleType</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Most Common Rank</span>
                            <span class="summary-value">@Model.ComparisonResult.Player1.MostCommonRank</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="player-column">
                <div class="player-card">
                    <h2>@Model.ComparisonResult.Player2.PlayerName</h2>
                    <div class="player-id">@Model.ComparisonResult.Player2.TekkenId</div>

                    <div class="stat-box">
                        <div class="stat-label">Overall Win Rate</div>
                        <div class="stat-value">@Model.ComparisonResult.Player2.OverallWinRate.ToString("F2")%</div>
                    </div>

                    <div class="summary-list">
                        <div class="summary-item">
                            <span class="summary-label">Region</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.Region</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Total Battles</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.TotalBattles</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Average Tekken Power</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.AverageTekkenPower.ToString("F0")</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Average Rounds Won</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.AverageRoundsWon.ToString("F2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Most Played Character</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player2.MostPlayedCharacter
                                (@Model.ComparisonResult.Player2.MostPlayedCharacterGames)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Best Character</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player2.BestCharacter
                                (@Model.ComparisonResult.Player2.BestCharacterWinRate.ToString("F2")%)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Worst Matchup</span>
                            <span class="summary-value">
                                @Model.ComparisonResult.Player2.WorstMatchupCharacter
                                (@Model.ComparisonResult.Player2.WorstMatchupWinRate.ToString("F2")%)
                            </span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Favorite Battle Type</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.FavoriteBattleType</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Most Common Rank</span>
                            <span class="summary-value">@Model.ComparisonResult.Player2.MostCommonRank</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="comparison-summary">
            <h2>Comparison Winners</h2>

            <div class="winner-grid">
                <div class="winner-item">
                    <span class="winner-label">Better Win Rate</span>
                    <span class="winner-value">@Model.ComparisonResult.BetterWinRatePlayer</span>
                </div>
                <div class="winner-item">
                    <span class="winner-label">Higher Tekken Power</span>
                    <span class="winner-value">@Model.ComparisonResult.BetterTekkenPowerPlayer</span>
                </div>
                <div class="winner-item">
                    <span class="winner-label">Better Average Rounds Won</span>
                    <span class="winner-value">@Model.ComparisonResult.BetterRoundsWonPlayer</span>
                </div>
                <div class="winner-item">
                    <span class="winner-label">More Consistent Character</span>
                    <span class="winner-value">@Model.ComparisonResult.MoreConsistentCharacterPlayer</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .compare-page {
        color: #e0e0e0;
    }

    .compare-header {
        margin-bottom: 30px;
        padding: 20px;
        background-color: rgba(50, 45, 70, 0.8);
        border-radius: 8px;
        border: 1px solid #667eea;
    }

        .compare-header h1 {
            margin: 0 0 8px 0;
            color: #f0f0f0;
        }

        .compare-header p {
            margin: 0;
            color: #b0b0b0;
        }

    .compare-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .player-card {
        background: rgba(45, 34, 87, 0.5);
        border: 1px solid #667eea;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.2);
    }

        .player-card h2 {
            margin-top: 0;
            color: #f0f0f0;
        }

    .player-id {
        margin-bottom: 20px;
        color: #b0b0b0;
        font-size: 14px;
    }

    .stat-box {
        margin-bottom: 20px;
        padding: 15px;
        background-color: rgba(102, 126, 234, 0.15);
        border-left: 4px solid #667eea;
        border-radius: 6px;
    }

    .stat-label {
        font-size: 13px;
        color: #b0b0b0;
        margin-bottom: 6px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: bold;
        color: #66a3ff;
    }

    .summary-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 12px;
        background-color: rgba(60, 50, 80, 0.75);
        border-radius: 6px;
    }

    .summary-label {
        color: #b0b0b0;
        font-weight: bold;
    }

    .summary-value {
        color: #f0f0f0;
        text-align: right;
    }

    .comparison-summary {
        padding: 20px;
        background-color: rgba(50, 45, 70, 0.8);
        border-radius: 8px;
        border: 1px solid #667eea;
    }

        .comparison-summary h2 {
            margin-top: 0;
            margin-bottom: 16px;
            color: #f0f0f0;
        }

    .winner-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .winner-item {
        padding: 14px 16px;
        background-color: rgba(60, 50, 80, 0.75);
        border-left: 4px solid #667eea;
        border-radius: 8px;
    }

    .winner-label {
        display: block;
        font-size: 13px;
        color: #b0b0b0;
        margin-bottom: 6px;
    }

    .winner-value {
        font-size: 16px;
        font-weight: bold;
        color: #f0f0f0;
    }

    .error-box {
        margin-bottom: 20px;
        padding: 15px;
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        border-radius: 6px;
        color: #f0f0f0;
    }

    @@media (max-width: 900px) {
        .compare-grid,
        .winner-grid {
            grid-template-columns: 1fr;
        }
    }
</style>