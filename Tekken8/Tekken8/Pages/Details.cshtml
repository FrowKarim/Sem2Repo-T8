@page
@model Tekken8.Pages.DetailsModel
@{
    ViewData["Title"] = Model.SingleCharacter?.Name ?? "Character Details";
}

<div class="container mt-5">
    @if (Model.SingleCharacter != null)
    {
        <h1 class="mb-4">Tekken 8 @Model.SingleCharacter.Name moves</h1>
        <div class="page-tools mb-4">
            <span class="page-tools-label">Helpful links</span>
            <a href="https://wavu.wiki/t/Notation" target="_blank" class="page-tool-link">
                Glossary
            </a>
            <a href="https://youtube.com/shorts/lHaGofVge3I?si=ZhY1ah63FTnMirMb" target="_blank" class="page-tool-link">
                What do all these numbers mean?
            </a>
        </div>
            
        @if (Model.SingleCharacter.Moves != null && Model.SingleCharacter.Moves.Count > 0)
        {
            <div class="row character-details">
                @foreach (var move in Model.SingleCharacter.Moves)
                {
                    var blockText = (move.Block ?? "").ToString().Trim();
                    var resultColor = "#fff";

                    if (int.TryParse(blockText, out var blockValue))
                    {
                        if (blockValue > 0)
                        {
                            resultColor = "#4ade80"; // green for + frames
                        }
                        else if (blockValue == 0)
                        {
                            resultColor = "#ffffff"; // white for neutral/misc
                        }
                        else if (blockValue >= -9)
                        {
                            resultColor = "#fde047"; // yellow/orange for -1 to -9 
                        }
                        else if (blockValue <= -10)
                        {
                            resultColor = "#ef4444"; // red for unsafe moves
                        }
                    }
                    

                    <div class="col-sm-6 col-md-4 col-lg-4 mb-4">
                        <a asp-page="/MoveDetails"
                           asp-route-characterId="@Model.SingleCharacter.Id"
                           asp-route-moveId="@move.Id"
                           class="move-card-link text-decoration-none">

                            <div class="move-card h-100">
                                <div class="move-card-header">
                                    <div class="move-command">@move.Command</div>
                                    <div class="move-command">@move.Name</div>
                                </div>

                                <div class="move-card-body">
                                    <div class="stat-grid">
                                        <div class="stat-item with-divider">
                                            <div class="stat-value">@move.Startup</div>
                                            <div class="stat-label">STARTUP</div>
                                        </div>
                                        <div class="stat-item with-divider">
                                            <div class="stat-value">@move.HitLevel</div>
                                            <div class="stat-label">HIT LEVEL</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-value">@move.Recovery</div>
                                            <div class="stat-label">RECOVERY</div>
                                        </div>
                                    </div>

                                    <div class="stat-grid second-grid">
                                        <div class="stat-item with-divider">
                                            <div class="stat-value" style="color: @resultColor;">@move.Block</div>
                                            <div class="stat-label">ON BLOCK</div>
                                        </div>
                                        <div class="stat-item with-divider">
                                            <div class="stat-value">@move.Hit</div>
                                            <div class="stat-label">ON HIT</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-value">@move.CounterHit</div>
                                            <div class="stat-label">ON COUNTER</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No moves found for this character.</p>
        }
    }
    else
    {
        <p>Character not found.</p>
    }
</div>

<style>

    .move-card-link {
    display: block;
    color: inherit;
}

    .move-card {
        background: linear-gradient(135deg, #2e225a 0%, #292636 55%, #232226 100%);
        color: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #4b5563;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 300px; /* pick a consistent card height */
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

.move-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.45);
    border-color: #8b5cf6;
}

.move-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
}

.move-command {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
}

.move-menu {
    font-size: 1.4rem;
    color: #d1d5db;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 999px;
    transition: background 0.2s ease;
}

.move-menu:hover {
    background: rgba(255, 255, 255, 0.08);
}

.move-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
}

.move-media img,
.move-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.move-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 24px;
}

.second-grid {
    margin-bottom: 32px;
}

.stat-item {
    position: relative;
    min-width: 0;
}

.with-divider::after {
    content: "";
    position: absolute;
    top: 0;
    right: -9px;
    width: 1px;
    height: 100%;
    background: #4b5563;
}

.stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
    word-break: break-word;
}

.stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9ca3af;
    text-transform: uppercase;
}

.text-danger-custom {
    color: #f87171;
}

.move-card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.mini-pill {
    border: 1px solid #a78bfa;
    background: transparent;
    color: #d1d5db;
    border-radius: 999px;
    min-width: 52px;
    height: 40px;
    padding: 0 16px;
    font-weight: 700;
}

.learn-more {
    display: inline-flex;
    align-items: center;
    border: 2px solid #3b2a67;
    color: white;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
}

.move-card:hover .learn-more {
    border-color: #a78bfa;
    background: rgba(167, 139, 250, 0.08);
}

    .page-tools {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        margin-top: -10px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid #3f3f46;
        border-radius: 12px;
        width: fit-content;
    }

    .page-tools-label {
        font-size: 0.8rem;
        color: #9ca3af;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .page-tool-link {
        font-size: 0.9rem;
        color: #c4b5fd;
        text-decoration: none;
        padding: 6px 10px;
        border-radius: 8px;
        background: rgba(139, 92, 246, 0.08);
        transition: background 0.2s ease, color 0.2s ease;
    }

        .page-tool-link:hover {
            background: rgba(139, 92, 246, 0.18);
            color: #ffffff;
        }
</style>